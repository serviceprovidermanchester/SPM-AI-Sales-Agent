# Run `python scripts/bootstrap.py` to generate a local .env with safe random credentials.
ADMIN_PASSWORD=SET_WITH_BOOTSTRAP
SECRET_KEY=SET_WITH_BOOTSTRAP
DATABASE_PATH=data/app.db
COOKIE_SECURE=false
PUBLIC_FORM_ENABLED=true
# Optional; when blank, Template Draft works without external AI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
